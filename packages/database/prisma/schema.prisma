// ============================================
// BroAgent — Prisma Schema (MySQL / XAMPP)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String?  @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  image     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threads  ConversationThread[]
  memories Memory[]
}

// ── Conversations ────────────────────────────

model ConversationThread {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Conversation") @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  workflows WorkflowRun[]

  @@index([userId])
}

// ── Messages ─────────────────────────────────

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String   @db.VarChar(30) // user, assistant, system
  content        String?  @db.LongText
  createdAt      DateTime @default(now())

  conversation ConversationThread @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ── Memory ───────────────────────────────────

model Memory {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.LongText
  type      String   @default("general") @db.VarChar(50) // general, emotional, academic, preference
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Workflow Runs ────────────────────────────

model WorkflowRun {
  id             String    @id @default(cuid())
  conversationId String
  intent         String    @default("general") @db.VarChar(50)
  status         String    @default("pending") @db.VarChar(50) // pending, running, completed, failed
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  conversation ConversationThread @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

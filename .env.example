# ============================================
# BroAgent — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ── Supabase Client (Server-side Database Access) ──
# Obtain from Supabase Dashboard: Project Settings -> API
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# ── Backend Configuration ──────────────────────
PORT=4000
# AUTH_SECRET is REQUIRED. Generate your own strong random secret
# (at least 32 characters, e.g. `openssl rand -base64 48`) and place it here.
# The API refuses to start when it is missing or empty. Never commit a real secret.
AUTH_SECRET=""
CORS_ORIGIN="http://localhost:3000"


# ── Service URLs ──────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
AI_AGENT_URL="http://localhost:8000"          # Python agent service (real web-search adapter)

# ── Gemini (LLM provider) ─────────────────────
# BroAgent talks directly to Gemini via Google's OpenAI-compatible endpoint.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=""                                             # Gemini API key
GEMINI_MODEL="gemini-3.5-flash-lite"                            # Model name (fast, free-tier friendly)
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"  # OpenAI-compatible base URL
GEMINI_TIMEOUT_MS="120000"                                    # Per-request timeout for an AI turn

# ── Groq (LLM provider, OpenAI-compatible) ──────
# Get a key from Groq Console: https://console.groq.com/keys
# Daftar model: https://console.groq.com/docs/models
GROQ_API_KEY=""                                               # Groq API key (wajib agar model Groq bisa dipilih)
GROQ_MODEL="openai/gpt-oss-20b"                              # Default Groq model
GROQ_BASE_URL="https://api.groq.com/openai/v1"                # OpenAI-compatible base URL
GROQ_TIMEOUT_MS="120000"                                      # Per-request timeout untuk model Groq

# ── Skills & Tools ────────────────────────────
WEB_SEARCH_PROVIDER="duckduckgo"               # duckduckgo, tavily, etc.
WEB_SEARCH_API_KEY=""                          # API Key for the search provider if required
